      <rdf:Description rdf:about=""
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/">
         <pdf:Keywords>Population dynamics on networks; Game Theory; Social Networks; Distributed Algorithms/Control</pdf:Keywords>
         <pdf:Producer>PDFlib+PDI 8.0.1p8 (Perl 5.10.0/Linux-x86_64)</pdf:Producer>
      </rdf:Description>
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:creator>
