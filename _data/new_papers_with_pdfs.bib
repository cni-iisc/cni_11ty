}

@CONFERENCE{Sheela2022877,
	author = {Sheela, C. and Kuri, Joy and Akhtar, Nadeem},
	title = {Performance Analysis of Channel-Dependent Rate Adaptation for OFDMA transmission in IEEE 802.11ax WLANs},
	year = {2022},
