	title = {Single-Forking of Coded Subtasks for Straggler Mitigation},
	year = {2021},
	journal = {IEEE/ACM Transactions on Networking},
	volume = {29},
	number = {6},
	pages = {2413 – 2424},
	doi = {10.1109/TNET.2021.3075377},
